# =========================================================================
# Fund My Mac / VESPER Campaign Environment Configuration
# =========================================================================

# -------------------------------------------------------------------------
# 1. Client Environment Variables (Safe for Browser & Bundler)
# -------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Optional: Milestone display on X (Founder Roadshow Reach Target)
VITE_X_VIEWS=13000000

# -------------------------------------------------------------------------
# 2. Server-Side Privileged Secrets (NEVER prefix with VITE_ or expose to Git)
# Used by Node backend / Supabase Edge Functions / serverless endpoints
# -------------------------------------------------------------------------
# Supabase Service Role Key (Bypasses RLS for secure order fulfillment)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Stripe Payment Provider Secret Key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe Webhook Signing Secret (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
