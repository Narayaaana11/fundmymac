# =========================================================================
# Fund My Mac / VESPER Campaign Environment Configuration
# =========================================================================

# -------------------------------------------------------------------------
# 1. Client Environment Variables (Safe for Browser & Bundler)
# -------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Razorpay Standard Checkout Key ID (rzp_test_... or rzp_live_...)
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# Public URL of the deployed application
VITE_PUBLIC_SITE_URL=https://fundmymac.com

# Optional: Milestone display on X (Founder Roadshow Reach Target)
VITE_X_VIEWS=13000000

# -------------------------------------------------------------------------
# 2. Server-Side Privileged Secrets (NEVER prefix with VITE_ or expose to Git)
# Used by Node backend / Supabase Edge Functions / serverless endpoints
# -------------------------------------------------------------------------
# Supabase URL and Service Role Key (Bypasses RLS for secure order fulfillment)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Razorpay Merchant Credentials
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhook Signing Secret (Configured in Razorpay Dashboard -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret

# Mode: 'production' fails closed if required secrets are missing.
NODE_ENV=development
