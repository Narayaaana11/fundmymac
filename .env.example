# ==========================================
# Fund My Mac Realtime & Backend Environment
# ==========================================

# Option 1: Supabase Realtime (Recommended - matching BrandMyMac's exact backend)
# Get these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Option 2: Custom WebSocket Server (Alternative)
# VITE_WS_URL=wss://your-websocket-server.com/live

# Optional custom X (Twitter) impressions milestone override
# VITE_X_VIEWS=13000000
